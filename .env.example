# 默认连接真实网易云；demo 仅播放本地合成音频，不使用真实账号。
MUSIC_PROVIDER=netease
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# 公网部署时填写页面的实际来源；开发时 Vite 使用 5173 端口。
PUBLIC_ORIGIN=http://localhost:5173
# 生产环境必须分别提供：随机 32 字节 base64 编码、至少 32 字符随机字符串。
# 本地开发不填时会生成 data/secrets.json，请保留它以便解密已保存的凭据。
CREDENTIAL_KEY=
SESSION_SECRET=
# 仅在可信反向代理后启用；HTTPS 部署时将 COOKIE_SECURE 设为 true。
TRUST_PROXY=false
COOKIE_SECURE=false
